# Copy to .env and export these in your shell; the backend reads real environment variables only.
# Relative paths are resolved against the repository root.

# CHUNKVAULT_DATA_DIR=data
# CHUNKVAULT_DB_PATH=data/chunkvault.db
# CHUNKVAULT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Content-defined chunking (bytes). Must satisfy window <= min < avg < max.
# CHUNKVAULT_CDC_MIN_CHUNK_SIZE=4096
# CHUNKVAULT_CDC_AVG_CHUNK_SIZE=16384
# CHUNKVAULT_CDC_MAX_CHUNK_SIZE=131072
# CHUNKVAULT_CDC_WINDOW_SIZE=64

# Frontend (optional): call the backend directly instead of through the Vite proxy.
# VITE_API_BASE_URL=http://127.0.0.1:8000
