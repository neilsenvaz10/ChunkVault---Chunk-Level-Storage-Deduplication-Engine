# Copy to .env and export these in your shell; the backend reads real environment variables only.
# Relative paths are resolved against the repository root.

# CHUNKVAULT_DATA_DIR=data
# CHUNKVAULT_DB_PATH=data/chunkvault.db
# CHUNKVAULT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Content-defined chunking (bytes). Must satisfy window <= min < avg < max.
# CHUNKVAULT_CDC_MIN_CHUNK_SIZE=4096
# CHUNKVAULT_CDC_AVG_CHUNK_SIZE=16384
# CHUNKVAULT_CDC_MAX_CHUNK_SIZE=131072
# CHUNKVAULT_CDC_WINDOW_SIZE=64

# Frontend (optional): call the backend directly instead of through the Vite proxy.
# VITE_API_BASE_URL=http://127.0.0.1:8000

# Phase 2: storage engine limits
# CHUNKVAULT_MAX_UPLOAD_BYTES=67108864
# CHUNKVAULT_WRITER_LOCK_TIMEOUT_SECONDS=30
# CHUNKVAULT_STAGING_STALE_SECONDS=300

# Phase 5/6: opt-in fault lab (default off) and the Host header allow-list (DNS-rebinding defence)
# CHUNKVAULT_ENABLE_FAULT_LAB=1
# CHUNKVAULT_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Advisory free-space margin kept on the chunk store's volume when accepting an upload (default 16 MiB)
# CHUNKVAULT_FREE_SPACE_RESERVE_BYTES=16777216

# ---------------------------------------------------------------------------------------------------------------
# Cloud backend (Supabase PostgreSQL + Storage). Default is CHUNKVAULT_BACKEND=local (SQLite + filesystem).
# Set these ONLY in the backend host's environment (Render dashboard) or a local uncommitted .env. NEVER as VITE_* variables.
# CHUNKVAULT_BACKEND=cloud
# DATABASE_URL=postgresql://<app role>.<project-ref>:<password>@<pooler-host>:5432/postgres   # session pooler, app role (not owner)
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_KEY=<service-role key>        # server only
# SUPABASE_BUCKET=chunkvault-chunks              # private bucket
# CHUNKVAULT_DEMO_TOKEN=<random, >= 24 chars>
# CHUNKVAULT_ADMIN_TOKEN=<random, >= 24 chars, different from the demo token>
# CHUNKVAULT_CORS_ORIGINS=https://<your-app>.vercel.app
# Optional tuning: CHUNKVAULT_CLOUD_IO_WORKERS=4 CHUNKVAULT_CLOUD_BATCH_CHUNKS=64 CHUNKVAULT_VERIFY_ON_REUSE=exists
#   CHUNKVAULT_STORED_BYTES_CAP=314572800 CHUNKVAULT_ORPHAN_MIN_AGE_SECONDS=900 CHUNKVAULT_TRUSTED_PROXY_HOPS=1 CHUNKVAULT_TRUSTED_PROXY_CIDRS=<proxy network, unset = header never trusted> CHUNKVAULT_DB_POOL_MAX=4
# Tests only: TEST_DATABASE_URL=postgresql://postgres@127.0.0.1:55432/postgres   (throw-away server: scripts/test_postgres.py)
# Supabase Storage client (all optional): CHUNKVAULT_STORAGE_TIMEOUT_SECONDS=20 CHUNKVAULT_STORAGE_MAX_ATTEMPTS=3

# Deployment (Render): render.yaml is the blueprint. The backend adds Render's own RENDER_EXTERNAL_HOSTNAME to its Host allow-list
# automatically (cloud backend only); use CHUNKVAULT_ALLOWED_HOSTS only for a custom domain. Health: /api/health/live (no database; the
# platform health check) and /api/health (alias /api/health/ready; includes the database). Owner URL (OWNER_DATABASE_URL) stays on your machine.
# Cloud abuse limits / deadlines (all optional, defaults shown): CHUNKVAULT_UPLOAD_DEADLINE_SECONDS=90 CHUNKVAULT_UPLOAD_CLEANUP_BUDGET_SECONDS=30
#   CHUNKVAULT_RATE_LIMITING=true CHUNKVAULT_MAX_CONCURRENT_UPLOADS=2 CHUNKVAULT_MAX_CONCURRENT_RESTORES=3 CHUNKVAULT_AUTH_FAILURE_LIMIT=10
#   CHUNKVAULT_AUTH_FAILURE_WINDOW_SECONDS=300 CHUNKVAULT_EXPENSIVE_REQUESTS_PER_MINUTE=30 CHUNKVAULT_STARTUP_RETRY_SECONDS=5
